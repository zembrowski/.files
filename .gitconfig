[user]
    name = Krzysztof Tomasz Zembrowski
    email = zembrowski@users.noreply.github.com
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFzgCNvriJWpI+UCz4XhEfhGfxbM6s6w0ycB0gesiHcf
[core]
    autocrlf = input
[push]
    autoSetupRemote = true
[credential]
    helper = cache
[alias]
    forget="!git fetch -p && git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D"
    forgetlist="!git fetch -p && git branch -vv | awk '/: gone]/{print $1}'"
    nah = "!f(){ git reset --hard; git clean -df; if [ -d ".git/rebase-apply" ] || [ -d ".git/rebase-merge" ]; then git rebase --abort; fi; }; f"
    uncommit = reset --soft HEAD~1
[gpg]
    format = ssh
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
    gpgsign = true
